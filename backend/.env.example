# development | test | staging | production  (API docs are served only in development/test)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# JSON API body limit in bytes (audio never goes through the API). 1..16777216
MAX_REQUEST_BODY_BYTES=1048576
# Request budget in seconds (504 after this). 0 < x <= 300
REQUEST_TIMEOUT_SECONDS=30

# PostgreSQL (the backend and worker are the only clients, ADR-0009). Unset = health only.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# S3-compatible object storage for temporary audio (R2 in production, MinIO locally).
# All three of bucket, key id and secret must be set, or uploads return 503.
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_URL_TTL_SECONDS=900
MAX_UPLOAD_BYTES=20971520
MAX_UPLOAD_DURATION_MS=1800000
DAILY_UPLOAD_BYTES_QUOTA=536870912

# Gate B: stays "disabled" until a provider passes the cost, terms, and consent review.
# "deepgram" (ADR-0018) requires DEEPGRAM_API_KEY — the worker exits at startup without it,
# rather than accepting audio it cannot process.
TRANSCRIPTION_PROVIDER=disabled
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# Extraction + daily reports (ADR-0019), full_cloud accounts only. Same posture: ships
# "disabled"; "claude" requires CLAUDE_API_KEY.
EXTRACTION_PROVIDER=disabled
# CLAUDE_API_KEY=
# CLAUDE_MODEL=

# Tests only: a throwaway database whose public schema is dropped and rebuilt.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/aidm_test
